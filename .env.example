# ---------------------------------------------------------------------------
# MEDIMATE environment — copy to `.env` (never commit `.env`).
# Every value below is a SAFE PLACEHOLDER for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Public origin of the web app (used for CORS/CSRF origin checks and payment redirects).
APP_ORIGIN=http://localhost:5173

# Database.
# Leave DATABASE_URL empty to use the embedded PGlite (real PostgreSQL compiled to WASM)
# stored in PGLITE_DIR — no Docker or Postgres install needed for the local demo.
# Set DATABASE_URL to use a real PostgreSQL server instead (see docker-compose.yml).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Server secret used to pepper OTP hashes. Generate a long random value for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=dev-only-change-me-to-a-long-random-string

# Demo mode shows the fictional-data banner, enables the SMS/USSD simulator and demo tools.
# Must be false in production.
DEMO_MODE=true

# OTP provider: "dev" shows the code on screen (development only, refused when NODE_ENV=production)
# or "sms" sends it through the configured MESSAGING_PROVIDER.
OTP_PROVIDER=dev

# Messaging (SMS) provider: "simulator" (no real SMS is ever sent) or "africastalking".
MESSAGING_PROVIDER=simulator
# Only needed when MESSAGING_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENVIRONMENT=sandbox
# Shared secret your SMS/USSD gateway must send in the `x-medimate-webhook-secret` header.
INBOUND_WEBHOOK_SECRET=

# Placeholders shown to users until real numbers are provisioned (labelled as demo in the UI).
SMS_SHORT_CODE=DEMO-12345
USSD_CODE=*123#

# Payments: "demo" (test checkout, no money moves) or "fapshi".
PAYMENTS_PROVIDER=demo
# Fapshi — https://docs.fapshi.com — create a *collection* service on the Fapshi dashboard.
FAPSHI_ENV=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Set the same value as the webhook secret on the Fapshi dashboard (sent as `x-wh-secret`).
FAPSHI_WEBHOOK_SECRET=

# Reminder engine timings (minutes)
REMINDER_FOLLOWUP_MINUTES=30
REMINDER_ESCALATE_MINUTES=60
REMINDER_MISSED_MINUTES=180
SCHEDULER_INTERVAL_SECONDS=30
