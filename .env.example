# ---------------------------------------------------------------------------
# MEDIMATE environment: copy to `.env` (never commit `.env`).
# Every value below is a SAFE PLACEHOLDER for local development.
# With no `.env` at all the app still runs: embedded database, SMS simulator, test checkout.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Public origin(s) of the web app, comma-separated (CSRF origin check and payment return links).
APP_ORIGIN=http://localhost:5173

# Database.
# Leave DATABASE_URL empty to use the embedded PGlite (real PostgreSQL compiled to WASM)
# stored in PGLITE_DIR. No Docker or Postgres install is needed for the local demo.
# Set DATABASE_URL to use a real PostgreSQL server instead (Neon, or see docker-compose.yml).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Server secret used to pepper OTP hashes. Generate a long random value for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=dev-only-change-me-to-a-long-random-string

# Demo mode shows the fictional-data banner, enables the SMS/USSD simulator and demo tools.
DEMO_MODE=true
# A public DEMO site (the hackathon deployment). Allows demo mode with NODE_ENV=production.
# The simulator then accepts only fictional +237 600 xxx xxx numbers. Never set for real patients.
PUBLIC_DEMO=false

# OTP provider: "dev" shows the code on screen for fictional +237 600 numbers, and for any number while
# MESSAGING_PROVIDER=simulator (the public demo refuses real numbers until a real SMS provider is set).
# With a real provider, every other number gets its code by SMS. "sms" always sends by SMS.
OTP_PROVIDER=dev

# Messaging (SMS) provider: "simulator" (no real SMS is ever sent), "twilio" or "africastalking".
MESSAGING_PROVIDER=simulator
# Twilio (MESSAGING_PROVIDER=twilio). Trial accounts only deliver to Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sending number in E.164 (e.g. +15551234567), or leave empty and set a Messaging Service SID.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Africa's Talking (MESSAGING_PROVIDER=africastalking). Implemented, not verified against a live account.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENVIRONMENT=sandbox
# Shared secret your SMS/USSD gateway must send in the `x-medimate-webhook-secret` header.
INBOUND_WEBHOOK_SECRET=

# Firebase web config for email and Google sign-in. These identify the project; they are public by
# design (Firebase security comes from Authorized domains and the server verifying ID tokens).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Placeholders shown to users until real numbers are provisioned (labelled as demo in the UI).
SMS_SHORT_CODE=DEMO-12345
USSD_CODE=*123#

# Payments: "demo" (test checkout, no money moves) or "fapshi".
PAYMENTS_PROVIDER=demo
# Fapshi: https://docs.fapshi.com. Use the apiuser and apikey of a collection service.
FAPSHI_ENV=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Set the same value as the webhook secret on the Fapshi dashboard (sent as `x-wh-secret`).
FAPSHI_WEBHOOK_SECRET=

# Reminder engine timings (minutes)
REMINDER_FOLLOWUP_MINUTES=30
REMINDER_ESCALATE_MINUTES=60
REMINDER_MISSED_MINUTES=180
# In-process scheduler interval. Set 0 on serverless hosts (Vercel); the engine then runs on
# requests, from the simulator and from the cron endpoint.
SCHEDULER_INTERVAL_SECONDS=30
# Bearer secret for GET /api/cron/tick (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=
